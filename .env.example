# ─────────────────────────────────────────────────────────────────────────────
# Portfolio — environment variables
# Copy to `.env.development` (local docker postgres) and `.env.production`
# (Neon). Never commit the populated files.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres connection string. Dev = docker postgres; Prod = Neon pooled URL.
DATABASE_URL=

# Optional: separate pooled URL (Neon's transaction pooler) if you want to keep
# the unpooled URL on DATABASE_URL for migrations.
DATABASE_URL_POOLER=

# AI provider keys — the TanStack AI add-on supports any of these. Set the one
# you intend to use. anthropicText() is the default in the scaffolded chat.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Runtime
NODE_ENV=development
PORT=3000
