# ─────────────────────────────────────────────────────────────────────────────
# Portfolio — environment variables
# Copy to `.env.development` (local docker postgres) and `.env.production`
# (Neon). Never commit the populated files.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres connection string. Dev = docker postgres (host port 5433);
# Prod = Neon pooled URL. The docker app service ignores this and uses the
# internal `db:5432` hostname instead; this value is for `pnpm dev` on the
# host or for psql from your shell.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/portfolio

# Optional: separate pooled URL (Neon's transaction pooler) if you want to keep
# the unpooled URL on DATABASE_URL for migrations.
DATABASE_URL_POOLER=

# ─── LLM provider ────────────────────────────────────────────────────────
# Pick one:  openrouter  | gemini
# `openrouter` = gateway to many providers (Claude, GPT, Gemini, …) with one key.
# `gemini`     = direct Google AI Studio key, talks to the Gemini OpenAI-compat
#                 endpoint. Only Gemini models available + free tier.
#
# IMPORTANT: LLM_PROVIDER and VITE_LLM_PROVIDER must match, and the key for
# the active provider must be populated. After editing this file, run
# `make restart` — docker only reads env_file at container start.
LLM_PROVIDER=openrouter
# Mirror for the client bundle. Vite exposes `import.meta.env.VITE_*` to the
# browser. Keep both lines in sync so the /model command shows the right list.
VITE_LLM_PROVIDER=openrouter

# OpenRouter — used when LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=
# Optional. Falls back to the first model in OPENROUTER_MODELS.
OPENROUTER_DEFAULT_MODEL=google/gemini-2.5-flash-lite

# Google AI Studio — used when LLM_PROVIDER=gemini.
# Get one at https://aistudio.google.com/app/apikey (free tier available).
GEMINI_API_KEY=
# Optional. Default = gemma-4-31b-it (free, 15 RPM, 1.5K RPD). Catalog: gemma-4-31b-it,
# gemma-4-26b-a4b-it, gemini-2.5-flash-lite (premium · capped to 5/visitor/day).
GEMINI_DEFAULT_MODEL=gemma-4-31b-it
# Free model pinned for classifier + commentary regardless of user selection.
# Keeps gating logic off the premium-paid quota.
LLM_FREE_MODEL=gemma-4-31b-it

# ─── GitHub ──────────────────────────────────────────────────────────────
# Used by /api/github-graph for the contribution heatmap.
# Token needs `read:user`; username is the profile we render.
GITHUB_TOKEN=
GITHUB_USERNAME=deepmandloi

# ─── IP intelligence ──────────────────────────────────────────────────────
# Free token from https://ipinfo.io/signup (50k lookups/month). Used for:
#   • /api/weather geo-resolution
#   • VPN/datacenter detection in the agent's rate limiter (when BLOCK_VPN=true)
IPINFO_TOKEN=

# ─── Agent rate limiting + abuse defenses ────────────────────────────────
# Random secret used to hash visitor IPs before storage. Required in prod;
# defaults to a literal in dev so the bootstrap experience doesn't fail.
RATE_LIMIT_SALT=
# Max messages per visitor per window. Default 5.
RATE_LIMIT_MAX=5
# Window length in ms. Default 24h.
RATE_LIMIT_WINDOW_MS=86400000
# Cap on completion tokens used per visitor inside the window. Stops one
# user with 5 long replies from burning the whole budget.
PER_IP_TOKEN_BUDGET=20000
# Site-wide circuit breaker: when daily completion tokens cross this, the
# agent serves a friendly "back tomorrow" message to everyone.
DAILY_TOKEN_BUDGET=200000
# When true (default), VPN/proxy/Tor/datacenter IPs (per IPInfo) are blocked
# on their first visit. Requires IPINFO_TOKEN.
BLOCK_VPN=true
# Server-side word cap on the prompt. The terminal mirrors this visually.
WORD_CAP=30
# Pre-flight classifier — runs a tiny LLM call to confirm the prompt is on
# topic before paying for the main reply. Visible to the user as a
# "checking…" activity line during the ~1s round-trip.
CLASSIFIER_ENABLED=true
# Optional override: route the classifier through a DIFFERENT provider than
# the main reply. Useful for staying on Gemini for chat while running the
# classifier for free on OpenRouter's nvidia/nemotron model.
CLASSIFIER_PROVIDER=openrouter
# Model used for the classifier. When CLASSIFIER_PROVIDER=openrouter the
# default is nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free — fast
# (~1s), free, and OpenRouter exposes its reasoning in a separate field so
# we don't need to strip <thought> tags. When CLASSIFIER_PROVIDER=gemini
# the default is gemini-2.5-flash-lite.
CLASSIFIER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# Ceiling on assistant output tokens per request. Gemma's reasoning block
# eats 200-400 tokens before the visible reply starts, so a tight budget
# truncates real answers. 2048 leaves room for the actual reply; Gemma has
# unlimited TPM on the free tier, so this only affects latency on long
# answers, not cost.
MAX_OUTPUT_TOKENS=2048
# Minimum gap between two requests from the same IP. Defense against bursts.
MIN_REQUEST_INTERVAL_MS=2000
# Wall-clock timeout on the main LLM stream. Generous because Gemma's
# reasoning block can take 15-25s on complex prompts before the first
# visible token. The classifier gets its own shorter 8s timeout
# internally so it can't eat the main budget.
REQUEST_TIMEOUT_MS=45000

# Runtime
NODE_ENV=development
PORT=3000
